{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Client",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "client"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Server",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "program": "${workspaceFolder}\\Server\\src\\server.js"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Server Script",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "server"
            ],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch Web Page",
            "runtimeExecutable": "npm",
            "runtimeArgs": [
                "run",
                "webApp"
            ],
            "cwd": "${workspaceFolder}"
        }
    ]
}